{
  "name": "@here.build/arrival-env",
  "version": "0.9.0",
  "description": "Type definitions and protocol for Arrival S-expression serialization",
  "keywords": [
    "arrival",
    "s-expressions",
    "serialization",
    "lisp"
  ],
  "homepage": "https://github.com/here-build/commons#readme",
  "bugs": {
    "url": "https://github.com/here-build/commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/commons.git",
    "directory": "packages/arrival-env"
  },
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*",
    "!**/*.stories.*"
