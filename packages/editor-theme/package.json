{
  "name": "@here.build/editor-theme",
  "version": "0.9.0",
  "description": "Hermetic CodeMirror 6 look: self-hosted fonts (JetBrains Mono writing / Monaspace reading) + H-K-compensated Darcula + full overlay/form/mark chrome. No CDN.",
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/commons#readme",
  "bugs": {
    "url": "https://github.com/here-build/commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/commons.git",
    "directory": "packages/editor-theme"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "OFL-JetBrainsMono.txt",
    "LICENSE-Monaspace.txt",
    "README.md",
    "LICENSE.md",
    "!**/stories/**",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6012",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@here.build/tsconfig": "workspace:^",
    "@lezer/highlight": "^1.2.3",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.10",
    "typescript": "catalog:",
    "vite": "^7.2.7"
  }
}
