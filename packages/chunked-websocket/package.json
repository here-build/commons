{
  "name": "@here.build/chunked-websocket",
  "version": "0.9.0",
  "description": "Transparent WebSocket message chunking — a transport-layer wrapper that splits >1 MiB messages into reassemblable chunks so workerd accepts them. Application code (Yjs, comments, awareness, …) sees a normal WebSocket. Adapted from partykit's y-partykit/src/chunking.ts.",
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/commons#readme",
  "bugs": {
    "url": "https://github.com/here-build/commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/commons.git",
    "directory": "packages/chunked-websocket"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/ChunkedWebSocket.d.ts",
      "import": "./dist/ChunkedWebSocket.js",
      "default": "./dist/ChunkedWebSocket.js"
    },
    "./server": {
      "types": "./dist/ChunkedDOTransport.d.ts",
      "import": "./dist/ChunkedDOTransport.js",
      "default": "./dist/ChunkedDOTransport.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "THIRD-PARTY-NOTICES.md",
    "!**/__tests__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@here.build/tsconfig": "workspace:^",
    "@types/ws": "^8.18.1",
    "lib0": "^0.2.117",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  }
}
