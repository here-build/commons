{
  "name": "@here.build/postcss-oklch-plus",
  "version": "0.9.0",
  "description": "oklch, but better: a correctly-gamut-clamped oklch() and a Helmholtz-Kohlrausch lightness-compensated oklchhk() — that partially-evaluate their trig away at build time. Static hue ⇒ zero runtime trig.",
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/commons#readme",
  "bugs": {
    "url": "https://github.com/here-build/commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/commons.git",
    "directory": "packages/postcss-oklch-plus"
  },
  "type": "module",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "oklch",
    "color",
    "gamut",
    "helmholtz-kohlrausch",
    "perceptual"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "dependencies": {
    "postcss-value-parser": "4.2.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/tsconfig": "workspace:^",
    "@types/culori": "4.0.0",
    "culori": "4.0.2",
    "@types/node": "24.0.0",
    "postcss": "8.4.49",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
