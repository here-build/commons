{
  "name": "@here.build/delta",
  "version": "0.10.0",
  "description": "Delta Design System - A mathematical constraint-based CSS design grammar",
  "keywords": [
    "constraints",
    "css",
    "delta",
    "design-grammar",
    "design-system"
  ],
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/commons#readme",
  "bugs": {
    "url": "https://github.com/here-build/commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/commons.git",
    "directory": "packages/delta"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./compose": {
      "types": "./src/compose.ts",
      "import": "./src/compose.ts",
      "default": "./src/compose.ts"
    },
    "./constants": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./chroma": {
      "types": "./src/chroma.ts",
      "import": "./src/chroma.ts",
      "default": "./src/chroma.ts"
    }
  },
  "main": "./dist/index.css",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "postcss src/**/*.css --base src --dir dist",
    "build-storybook": "storybook build",
    "dev": "postcss src/**/*.css --base src --dir dist --watch",
    "extended-test": "vitest run --config vitest.stories.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6001",
    "test": "echo 'No tests for CSS-only package'",
    "typecheck": " tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/postcss-oklch-plus": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@storybook/addon-a11y": "10.3.3",
    "@storybook/addon-vitest": "10.3.3",
    "@storybook/react": "10.3.3",
    "@storybook/react-vite": "^10.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.1",
    "@vitest/browser-playwright": "4.1.1",
    "cssnano": "7.1.3",
    "eslint": "catalog:",
    "globals": "17.3.0",
    "postcss": "8.4.49",
    "postcss-cli": "11.0.0",
    "postcss-custom-selectors": "9.0.1",
    "postcss-import": "16.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^10.0.0",
    "typescript": "catalog:",
    "vite": "7.2.7",
    "vitest": "4.1.0"
  }
}
